---
import type { CollectionEntry } from 'astro:content';
import ProjectCard from '../ui/ProjectCard.astro';
import SearchInput from '../ui/SearchInput.astro';
import { normalizeSearchText } from '../../utils/search';

export interface Props {
  projects: CollectionEntry<'projects'>[];
  lang?: 'en' | 'ar';
}

const { projects = [], lang = 'en' } = Astro.props;

const copy = {
  en: {
    heading: 'Project Catalogue',
    subtitle: 'All published engineering projects with evidence, architecture, and source code',
    totalLabel: 'projects',
    emptyTitle: 'No projects published yet',
    emptyDescription:
      'No engineering projects are currently published in this view. Check back soon for new verified case studies and proof of work.',
    noResultsTitle: 'No matching projects found',
    noResultsDescription:
      'No projects matched your search query. Try searching with different keywords, skills, or project types.',
    resetSearch: 'Reset search',
    showingAll: (total: number) => `${total} projects`,
    showingFiltered: (count: number, total: number) => `${count} of ${total} projects`,
  },
  ar: {
    heading: 'دليل المشاريع الشامل',
    subtitle: 'جميع المشاريع الهندسية المنشورة مع التفاصيل والأدلة التقنية',
    totalLabel: 'مشاريع',
    emptyTitle: 'لم يتم نشر مشاريع بعد',
    emptyDescription:
      'لا توجد مشاريع هندسية منشورة حالياً في هذا القسم. يرجى العودة قريباً للاطلاع على أحدث دراسات الحالة ونماذج العمل الموثقة.',
    noResultsTitle: 'لم يتم العثور على نتائج مطابقة',
    noResultsDescription:
      'لا توجد مشاريع تطابق عبارة البحث الحالية. جرب البحث بكلمات مفتاحية، مهارات، أو مجالات أخرى.',
    resetSearch: 'إعادة ضبط البحث',
    showingAll: (total: number) => `${total} مشاريع`,
    showingFiltered: (count: number, total: number) => `${count} من أصل ${total} مشاريع`,
  },
};

const t = copy[lang];

const typeLabels: Record<string, { en: string; ar: string }> = {
  software: { en: 'Software', ar: 'برمجيات' },
  ai: { en: 'AI', ar: 'ذكاء اصطناعي' },
  'ui-ux': { en: 'UI/UX', ar: 'واجهات وتجربة مستخدم' },
  design: { en: 'Design', ar: 'تصميم' },
  automation: { en: 'Automation', ar: 'أتمتة' },
  other: { en: 'Other', ar: 'أخرى' },
};

// Pre-compute normalized searchable text for each project
const getProjectSearchableText = (entry: CollectionEntry<'projects'>): string => {
  const p = entry.data;
  const title = p.title[lang] ?? p.title.en;
  const summary = p.summary[lang] ?? p.summary.en;
  const skills = p.skills.join(' ');
  const types = p.types.map((tp) => `${tp} ${typeLabels[tp]?.[lang] ?? ''}`).join(' ');
  return normalizeSearchText(`${title} ${summary} ${skills} ${types}`);
};
---

<section id="projects" class="scroll-mt-20 py-12 sm:py-16">
  <div class="mb-8 flex flex-col gap-6 md:flex-row md:items-end md:justify-between">
    <div class="max-w-xl">
      <div class="flex items-center gap-3">
        <h2 class="text-2xl font-semibold tracking-tight text-text sm:text-3xl">
          {t.heading}
        </h2>
        <span
          id="project-count-badge"
          role="status"
          aria-live="polite"
          class="rounded-pill bg-surface border border-border px-2.5 py-0.5 text-xs font-mono text-text-muted"
        >
          {t.showingAll(projects.length)}
        </span>
      </div>
      <p class="mt-2 text-sm text-text-muted sm:text-base">
        {t.subtitle}
      </p>
    </div>

    {projects.length > 0 && (
      <div class="w-full md:w-auto">
        <SearchInput id="project-search" lang={lang} />
      </div>
    )}
  </div>

  {projects.length > 0 ? (
    <>
      <div id="project-grid" class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {projects.map((project) => (
          <div
            data-project-card
            data-search={getProjectSearchableText(project)}
            class="transition-opacity duration-150"
          >
            <ProjectCard project={project.data} lang={lang} />
          </div>
        ))}
      </div>

      <!-- No matching search results container -->
      <div
        id="no-search-results"
        class="hidden rounded-lg border border-dashed border-border bg-surface/50 p-12 text-center"
      >
        <div class="mx-auto flex h-12 w-12 items-center justify-center rounded-pill border border-border bg-surface text-text-muted">
          <svg
            class="h-6 w-6"
            xmlns="http://www.w3.org/2000/svg"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="1.5"
            aria-hidden="true"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="m21 21-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 5.196a7.5 7.5 0 0 0 10.607 10.607Z"
            />
          </svg>
        </div>
        <h3 class="mt-4 text-base font-medium text-text">{t.noResultsTitle}</h3>
        <p class="mx-auto mt-2 max-w-md text-sm text-text-muted">{t.noResultsDescription}</p>
        <button
          type="button"
          id="reset-search-btn"
          class="mt-6 inline-flex h-9 items-center justify-center rounded-sm border border-border bg-surface px-4 text-xs font-medium text-text transition-colors hover:bg-surface-raised focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-focus"
        >
          {t.resetSearch}
        </button>
      </div>
    </>
  ) : (
    <div class="rounded-lg border border-dashed border-border bg-surface/50 p-12 text-center">
      <div class="mx-auto flex h-12 w-12 items-center justify-center rounded-pill border border-border bg-surface text-text-muted">
        <svg
          class="h-6 w-6"
          xmlns="http://www.w3.org/2000/svg"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="1.5"
          aria-hidden="true"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="m21 21-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 5.196a7.5 7.5 0 0 0 10.607 10.607Z"
          />
        </svg>
      </div>
      <h3 class="mt-4 text-base font-medium text-text">{t.emptyTitle}</h3>
      <p class="mx-auto mt-2 max-w-md text-sm text-text-muted">{t.emptyDescription}</p>
    </div>
  )}
</section>

<script>
  import { tokenizeQuery } from '../../utils/search';

  function initProjectSearch() {
    const searchInput = document.getElementById('project-search') as HTMLInputElement | null;
    const clearBtn = document.getElementById('project-search-clear') as HTMLButtonElement | null;
    const resetBtn = document.getElementById('reset-search-btn') as HTMLButtonElement | null;
    const countBadge = document.getElementById('project-count-badge');
    const noResults = document.getElementById('no-search-results');
    const cards = Array.from(document.querySelectorAll<HTMLElement>('[data-project-card]'));

    if (!searchInput || cards.length === 0) return;

    const total = cards.length;
    const isAr = document.documentElement.getAttribute('lang') === 'ar';

    function updateView() {
      const query = searchInput?.value ?? '';
      const tokens = tokenizeQuery(query);

      // Toggle clear button
      if (clearBtn) {
        if (query.trim().length > 0) {
          clearBtn.classList.remove('hidden');
          clearBtn.classList.add('flex');
        } else {
          clearBtn.classList.add('hidden');
          clearBtn.classList.remove('flex');
        }
      }

      let visibleCount = 0;

      cards.forEach((card) => {
        const text = card.getAttribute('data-search') || '';
        const matches = tokens.length === 0 || tokens.every((token) => text.includes(token));

        if (matches) {
          card.classList.remove('hidden');
          visibleCount++;
        } else {
          card.classList.add('hidden');
        }
      });

      // Update count badge
      if (countBadge) {
        if (tokens.length === 0) {
          countBadge.textContent = isAr ? `${total} مشاريع` : `${total} projects`;
        } else {
          countBadge.textContent = isAr
            ? `${visibleCount} من أصل ${total} مشاريع`
            : `${visibleCount} of ${total} projects`;
        }
      }

      // Toggle no-results card
      if (noResults) {
        if (visibleCount === 0 && tokens.length > 0) {
          noResults.classList.remove('hidden');
        } else {
          noResults.classList.add('hidden');
        }
      }
    }

    function clearQuery() {
      if (!searchInput) return;
      searchInput.value = '';
      updateView();
      searchInput.focus();
    }

    searchInput.addEventListener('input', updateView);

    searchInput.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        clearQuery();
      }
    });

    clearBtn?.addEventListener('click', clearQuery);
    resetBtn?.addEventListener('click', clearQuery);
  }

  initProjectSearch();
  document.addEventListener('astro:after-swap', initProjectSearch);
</script>
