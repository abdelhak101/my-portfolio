---
export interface Props {
  targetId?: string;
  label?: string;
}

const { targetId = 'main-content', label = 'Skip to content' } = Astro.props;
---

<a
  href={`#${targetId}`}
  class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:start-4 focus:z-50 focus:rounded-md focus:bg-inverse-bg focus:px-4 focus:py-2 focus:text-sm focus:font-medium focus:text-inverse-text focus:shadow-md focus:outline-none focus:ring-2 focus:ring-focus"
>
  {label}
</a>
