---
import type { CollectionEntry } from 'astro:content';
import ProjectCard from '../ui/ProjectCard.astro';

export interface Props {
  projects: CollectionEntry<'projects'>[];
  lang?: 'en' | 'ar';
}

const { projects, lang = 'en' } = Astro.props;

const heading = lang === 'ar' ? 'دليل المشاريع الشامل' : 'Project Catalogue';
const subtitle =
  lang === 'ar'
    ? 'جميع المشاريع الهندسية المنشورة مع التفاصيل والأدلة التقنية'
    : 'All published engineering projects with evidence, architecture, and source code';
const totalLabel = lang === 'ar' ? 'مشاريع' : 'projects';
---

<section id="projects" class="scroll-mt-20 py-12 sm:py-16">
  <div class="mb-8 flex flex-col sm:flex-row sm:items-end sm:justify-between gap-4">
    <div>
      <div class="flex items-center gap-3">
        <h2 class="text-2xl font-semibold tracking-tight text-text sm:text-3xl">
          {heading}
        </h2>
        <span class="rounded-pill bg-surface border border-border px-2.5 py-0.5 text-xs font-mono text-text-muted">
          {projects.length} {totalLabel}
        </span>
      </div>
      <p class="mt-2 text-sm text-text-muted sm:text-base">
        {subtitle}
      </p>
    </div>
  </div>

  <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
    {projects.map((project) => (
      <ProjectCard project={project.data} lang={lang} />
    ))}
  </div>
</section>
