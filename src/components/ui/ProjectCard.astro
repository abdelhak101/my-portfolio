---
import type { Project as CanonicalProject } from '../../content/schemas/project';

export interface LegacyProject {
  title: string | { en: string; ar: string };
  description?: string;
  summary?: string | { en: string; ar: string };
  image?: string;
  cover?: { src: string; alt?: string | { en: string; ar: string } };
  tags?: string[];
  skills?: string[];
  url?: string;
  links?: Array<{ url: string; label: string | { en: string; ar: string }; type?: string }>;
  outcomes?: Array<{ metric?: string; description: string | { en: string; ar: string } }>;
}

export type ProjectInput = CanonicalProject | LegacyProject;

export interface Props {
  project: ProjectInput;
  lang?: 'en' | 'ar';
  class?: string;
}

const { project, lang = 'en', class: extraClass = '' } = Astro.props;

// Resolution helpers for bilingual vs legacy flat strings
const getLocalized = (val: string | { en: string; ar: string } | undefined): string => {
  if (!val) return '';
  if (typeof val === 'string') return val;
  return val[lang] ?? val.en ?? '';
};

const title = getLocalized(project.title);
const description = getLocalized(
  'summary' in project && project.summary ? project.summary : 'description' in project ? project.description : ''
);
const imageSrc =
  'cover' in project && project.cover ? project.cover.src : 'image' in project ? project.image : undefined;
const imageAlt =
  'cover' in project && project.cover?.alt
    ? getLocalized(project.cover.alt)
    : `${title} thumbnail`;

const tags =
  'skills' in project && project.skills?.length
    ? project.skills
    : 'tags' in project && project.tags
      ? project.tags
      : [];

const url = 'url' in project && project.url ? project.url : undefined;
const links = 'links' in project && project.links ? project.links : [];
const outcomes = 'outcomes' in project && project.outcomes ? project.outcomes : [];

const containerClasses = [
  'group flex flex-col rounded-md border border-border bg-surface overflow-hidden shadow-sm hover:shadow-md hover:bg-surface-raised transition-all duration-150',
  extraClass,
]
  .filter(Boolean)
  .join(' ');
---

<article class={containerClasses}>
  {imageSrc ? (
    <img
      src={imageSrc}
      alt={imageAlt}
      class="h-48 w-full object-cover border-b border-border bg-surface"
      loading="lazy"
    />
  ) : (
    <div
      class="h-48 w-full border-b border-border bg-surface flex items-center justify-center text-text-subtle text-xs"
      aria-hidden="true"
    >
      No preview
    </div>
  )}

  <div class="flex flex-1 flex-col p-5">
    {url ? (
      <a
        href={url}
        class="group-hover:text-text font-semibold text-lg text-text tracking-tight focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-focus rounded-sm"
      >
        <h3>{title}</h3>
      </a>
    ) : (
      <h3 class="font-semibold text-lg text-text tracking-tight">{title}</h3>
    )}

    <p class="mt-2 text-sm text-text-muted flex-1 leading-relaxed">{description}</p>

    {outcomes.length > 0 && outcomes[0].metric && (
      <div class="mt-4 flex items-center gap-2">
        <span class="rounded-sm bg-inverse-bg px-2 py-0.5 text-xs font-mono font-medium text-inverse-text">
          {outcomes[0].metric}
        </span>
        <span class="text-xs text-text-subtle truncate">
          {getLocalized(outcomes[0].description)}
        </span>
      </div>
    )}

    {tags.length > 0 && (
      <div class="mt-4 flex flex-wrap gap-1.5">
        {tags.map((tag) => (
          <span class="rounded-sm border border-border px-2 py-0.5 text-xs font-mono text-text-muted">
            {tag}
          </span>
        ))}
      </div>
    )}

    {links.length > 0 && (
      <div class="mt-4 flex items-center gap-3 pt-3 border-t border-border">
        {links.map((link) => (
          <a
            href={link.url}
            target="_blank"
            rel="noopener noreferrer"
            class="text-xs font-medium text-text-muted hover:text-text focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-focus underline-offset-4 hover:underline"
          >
            {getLocalized(link.label)} ↗
          </a>
        ))}
      </div>
    )}
  </div>
</article>
